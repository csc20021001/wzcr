# Optional overrides. The verified publisher and course-list ad-unit IDs both
# have checked-in public fallbacks because AdSense IDs are visible page metadata.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=

# Google Cloud Console → OAuth 2.0 Web application.
# Local redirect URI: http://localhost:3000/api/auth/google/callback
# Production redirect URI: https://map.scmwcscr.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Public-facing contact email for your own deployment.
# The source snapshot uses contact@example.com until configured.
CONTACT_EMAIL=
